# F1 Manager Environment Configuration

# Application
APP_NAME=F1 Manager 2026
DEBUG=false

# Security Keys (generate secure random values for production!)
SECRET_KEY=change-this-to-a-secure-random-string
JWT_SECRET_KEY=change-this-to-another-secure-random-string

# JWT Settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Datastore Configuration
# Options: "local" (JSON files) or "postgres" (PostgreSQL database)
DATASTORE_TYPE=local
LOCAL_DATA_DIR=./data

# PostgreSQL (required when DATASTORE_TYPE=postgres)
# DATABASE_URL=postgresql://user:password@localhost:5432/f1manager

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]

# Rate Limiting
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=900
